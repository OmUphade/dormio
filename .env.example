# ===== App =====
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ===== Database / cache / storage =====
DATABASE_URL=postgresql://dormio:dormio_dev_password@localhost:5432/dormio
VALKEY_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dormio
S3_SECRET_KEY=dormio_dev_password
S3_BUCKET=dormio
S3_REGION=us-east-1

# ===== Auth (generate real random values; never commit) =====
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
COOKIE_DOMAIN=localhost

# ===== Email (dev uses Mailpit) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Dormio <no-reply@localhost>"

# ===== Maps / geocoding (OpenStreetMap services; keep cached + debounced) =====
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT="Dormio/0.1 (contact: you@example.com)"
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# ===== Web push (generate with web-push generate-vapid-keys) =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ===== AI (local first) =====
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional free-tier fallback for NON-personal content only
GEMINI_API_KEY=
GROQ_API_KEY=

# ===== Observability (optional, free tiers) =====
SENTRY_DSN=
